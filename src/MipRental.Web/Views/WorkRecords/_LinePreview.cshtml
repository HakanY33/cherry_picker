@model MipRental.Web.Models.WorkRecords.LinePreviewViewModel
@if (!Model.HasInput)
{
    <div class="text-muted small">Fiyat önizlemesi için hizmeti ve iş tarihi/saatlerini girin.</div>
}
else if (!Model.Success)
{
    <div class="alert alert-warning py-2 px-3 mb-0 small">@Model.ErrorMessage</div>
}
else
{
    @* Adım 9: bu önizleme yalnızca firma kullanıcısına açıktır ve firma tutar
       göremez. Bu yüzden burada tutar YOKTUR — modelde de yoktur. Gösterilen,
       "kaç saat faturalanacak" sorusunun cevabıdır. *@
    <div class="alert alert-light border py-2 px-3 mb-0 small">
        <div><strong>Faturalanacak miktar:</strong> @Model.BillableQuantity.ToString("0.####") @ServiceUnitDisplay.GetLabel(Model.Unit)</div>
        <ul class="mb-0 mt-1 ps-3">
            @foreach (var line in Model.QuantityExplanation)
            {
                <li>@line</li>
            }
        </ul>
    </div>
}
