@model ListViewModel<MipRental.Domain.Entities.ServiceVariant>
@{
    ViewData["Title"] = "Hizmet Varyantları";
}

<div class="page-header">
    <div class="page-title">
        <h1>Hizmet Varyantları</h1>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary">Yeni Varyant</a>
    </div>
</div>

<partial name="_SearchBox" model="Model.Page" />

<div id="list-container">
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Hizmet Tanımı</th>
                    <th>Kod</th>
                    <th>Ad</th>
                    <th>Kapasite</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var variant in Model.Items)
                {
                    <tr>
                        <td>@variant.ServiceCategory.Name</td>
                        <td>@variant.Code</td>
                        <td>@variant.Name</td>
                        <td>@variant.Capacity</td>
                        <td><partial name="_StatusBadge" model="variant.IsActive" /></td>
                        <td><a asp-action="Edit" asp-route-id="@variant.VariantId">Düzenle</a></td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">Kayıt bulunamadı.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Page" />
</div>
