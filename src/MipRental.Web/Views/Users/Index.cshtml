@model ListViewModel<MipRental.Domain.Entities.User>
@{
    ViewData["Title"] = "Kullanıcılar";
}

<div class="page-header">
    <div class="page-title">
        <h1>Kullanıcılar</h1>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary">Yeni Kullanıcı</a>
    </div>
</div>

<partial name="_SearchBox" model="Model.Page" />

<div id="list-container">
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Kullanıcı Adı</th>
                    <th>Ad Soyad</th>
                    <th>Firma</th>
                    <th>Roller</th>
                    <th>Son Giriş</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Items)
                {
                    <tr>
                        <td>@user.UserName</td>
                        <td>@user.FullName</td>
                        <td>@(user.Firm?.Title ?? "MIP")</td>
                        <td>@string.Join(", ", user.UserRoles.Select(ur => ur.Role.Name))</td>
                        <td>@(user.LastLoginAt?.ToString("g") ?? "—")</td>
                        <td><partial name="_StatusBadge" model="user.IsActive" /></td>
                        <td><a asp-action="Edit" asp-route-id="@user.UserId">Düzenle</a></td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">Kayıt bulunamadı.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Page" />
</div>
