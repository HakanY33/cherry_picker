@model MipRental.Web.Models.Users.UserCreatedViewModel
@{
    ViewData["Title"] = "Kullanıcı Oluşturuldu";
}

<h1>Kullanıcı Oluşturuldu</h1>

<div class="alert alert-warning form-page-narrow">
    <p><strong>Bu şifre yalnızca bir kez gösterilir, not alın.</strong> Sayfayı yenilerseniz tekrar görüntülenemez.</p>
    <dl class="row mb-0">
        <dt class="col-sm-4">Kullanıcı Adı</dt>
        <dd class="col-sm-8"><code>@Model.UserName</code></dd>
        <dt class="col-sm-4">Geçici Şifre</dt>
        <dd class="col-sm-8"><code>@Model.GeneratedPassword</code></dd>
    </dl>
</div>

<a asp-action="Index" class="btn btn-primary">Kullanıcı Listesine Dön</a>
