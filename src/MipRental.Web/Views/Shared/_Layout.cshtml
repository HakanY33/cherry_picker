@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MIP Hizmet Kiralama</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MipRental.Web.styles.css" asp-append-version="true" />
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
</head>
<body>
    <div class="app-shell d-flex">
        @{
            var canManageMaster = (await AuthorizationService.AuthorizeAsync(User, PolicyNames.CanManageMaster)).Succeeded;
            var canManageUsers = (await AuthorizationService.AuthorizeAsync(User, PolicyNames.CanManageUsers)).Succeeded;
            var canManageContract = (await AuthorizationService.AuthorizeAsync(User, PolicyNames.CanManageContract)).Succeeded;
            var canClosePeriod = (await AuthorizationService.AuthorizeAsync(User, PolicyNames.CanClosePeriod)).Succeeded;
            var canApprove = (await AuthorizationService.AuthorizeAsync(User, PolicyNames.CanApprove)).Succeeded;
        }
        @* Sol menü TEK navigasyon sistemidir ve oturum açmış HERKESE gösterilir.
           Eskiden yalnızca ana veri yetkisi olanlara açılıyordu; "Çalışma Kayıtları"
           ve "Onayımı Bekleyenler" ise üstteki şablon menüsündeydi. Üst menü
           kaldırıldığı için bu iki bağlantı buraya taşındı — yoksa firma
           kullanıcısında hiç navigasyon kalmazdı. *@
        @if (User.Identity?.IsAuthenticated == true)
        {
            <nav class="app-sidebar border-end p-3 bg-light">
                <ul class="nav flex-column">
                    <li class="nav-item"><span class="text-muted small text-uppercase">İşlemler</span></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="WorkRecords" asp-action="Index">Çalışma Kayıtları</a></li>
                    @if (canApprove)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Approvals" asp-action="Index">Onayımı Bekleyenler</a></li>
                    }
                    @if (canManageMaster)
                    {
                        <li class="nav-item"><span class="text-muted small text-uppercase">Tanımlar</span></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Firms" asp-action="Index">Firmalar</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Locations" asp-action="Index">Lokasyonlar</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="ServiceCategories" asp-action="Index">Hizmet Tanımları</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="ServiceVariants" asp-action="Index">Hizmet Varyantları</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Equipment" asp-action="Index">Araçlar</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Departments" asp-action="Index">Departmanlar</a></li>
                    }
                    @if (canManageContract || canClosePeriod)
                    {
                        <li class="nav-item"><span class="text-muted small text-uppercase">Sözleşme &amp; Dönem</span></li>
                        @if (canManageContract)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Contracts" asp-action="Index">Sözleşmeler</a></li>
                        }
                        @if (canClosePeriod)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Periods" asp-action="Index">Dönemler</a></li>
                        }
                    }
                    <li class="nav-item"><span class="text-muted small text-uppercase">Raporlar</span></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Summaries" asp-action="Index">Aylık İcmal</a></li>
                    @if (canManageUsers)
                    {
                        <li class="nav-item"><span class="text-muted small text-uppercase">Erişim</span></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">Kullanıcılar</a></li>
                    }
                </ul>
            </nav>
        }
        <div class="app-main d-flex flex-column">
            @* Üst bar SADECE kimlik alanıdır: solda uygulama adı, sağda kullanıcı
               ve çıkış. Şablondan gelen ikinci navigasyon (Home / Privacy /
               Çalışma Kayıtları) kaldırıldı; gezinme tek yerde, sol menüde. *@
            <header>
                <nav class="navbar navbar-light bg-white border-bottom mb-3">
                    <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
                        <a class="navbar-brand mb-0" asp-controller="Start" asp-action="Index">MIP Hizmet Kiralama</a>
                        <div class="d-flex align-items-center gap-3">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <span class="text-dark">@User.Identity.Name</span>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Çıkış Yap</button>
                                </form>
                            }
                            else
                            {
                                <a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                            }
                        </div>
                    </div>
                </nav>
            </header>
            <div class="app-content container-fluid px-4">
                @if (TempData[TempDataKeys.SuccessMessage] is string successMessage)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @successMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                    </div>
                }
                @if (TempData[TempDataKeys.ErrorMessage] is string errorMessage)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @errorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                    </div>
                }
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
            <footer class="border-top footer text-muted mt-auto">
                <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
                    <span>&copy; 2026 MIP Hizmet Kiralama</span>
                    <span id="appVersion" class="small opacity-50" style="cursor: default; user-select: none;">v1.0.0</span>
                </div>
            </footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Sürüm etiketine 3 saniye içinde 5 kez art arda tıklayana küçük bir teşekkür.
        // Sayaç ilk tıklamadan 3 saniye sonra kendini sıfırlar; seri tamamlanmazsa
        // baştan başlar. Kasıtlı olarak dikkat çekmez ve hiçbir kütüphane gerektirmez.
        (function () {
            var label = document.getElementById('appVersion');
            if (!label) { return; }

            var clicks = 0;
            var resetTimer = null;

            label.addEventListener('click', function () {
                if (clicks === 0) {
                    resetTimer = setTimeout(function () { clicks = 0; }, 3000);
                }

                if (++clicks < 5) { return; }

                clearTimeout(resetTimer);
                clicks = 0;

                // Üst üste binmesin: açık bir bildirim varsa önce o kaldırılır.
                var existing = document.getElementById('appVersionToast');
                if (existing) { existing.remove(); }

                var toast = document.createElement('div');
                toast.id = 'appVersionToast';
                toast.className = 'position-fixed bottom-0 end-0 m-3 px-3 py-2 rounded shadow-sm bg-dark text-white small';
                toast.style.zIndex = '1080';
                toast.style.transition = 'opacity .4s';
                toast.textContent = 'Developed by Hakan Yenidoğan';
                document.body.appendChild(toast);

                setTimeout(function () { toast.style.opacity = '0'; }, 2200);
                setTimeout(function () { toast.remove(); }, 2700);
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
