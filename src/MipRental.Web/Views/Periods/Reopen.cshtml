@model MipRental.Web.Models.Periods.PeriodReopenViewModel
@{
    ViewData["Title"] = "Dönemi Yeniden Aç";
}

<h1>Dönemi Yeniden Aç</h1>
<p class="text-muted">@PeriodStatusDisplay.GetMonthName(Model.Month) @Model.Year</p>

<partial name="_ValidationSummary" />

<form asp-action="Reopen" asp-route-id="@Model.PeriodId" method="post" class="row g-3 form-page-narrow">
    <input type="hidden" asp-for="PeriodId" />
    <div class="col-12">
        <label asp-for="ReopenReason" class="form-label"></label>
        <textarea asp-for="ReopenReason" class="form-control" rows="3" required></textarea>
        <span asp-validation-for="ReopenReason" class="text-danger"></span>
        <div class="form-text">Bu dönemi yeniden açma gerekçesi zorunludur.</div>
    </div>
    <div class="col-12 form-actions">
        <button type="submit" class="btn btn-primary">Dönemi Yeniden Aç</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
