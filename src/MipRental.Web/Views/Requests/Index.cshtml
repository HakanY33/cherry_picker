@using MipRental.Domain.Enums
@model MipRental.Web.Models.Requests.MyRequestsViewModel
@{
    ViewData["Title"] = "Taleplerim";
}

<div class="page-header">
    <div class="page-title">
        <h1>Taleplerim</h1>
        <div class="page-subtitle">Yalnızca sizin açtığınız talepler listelenir.</div>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary">Yeni Talep</a>
    </div>
</div>

@* Filtre DURUM alanı sadeleştirilmiş etiketle çalışır ("Bekliyor"); talep açana
   iç adımlar (Ekipman/Firma onayı) gösterilmediği için filtre de onlara göre
   sunulmaz. *@
<form class="filter-bar row g-2 align-items-end"
      hx-get="@Url.Action("Index")"
      hx-target="#list-container"
      hx-select="#list-container"
      hx-swap="outerHTML"
      hx-push-url="true"
      hx-trigger="change">
    <div class="col-auto">
        <label for="status" class="form-label mb-1">Durum</label>
        <select id="status" name="status" class="form-select">
            <option value="">— Tüm Durumlar —</option>
            @foreach (var option in RequestStatusDisplay.SummaryFilterOptions)
            {
                <option value="@option" selected="@(Model.Status == option ? "selected" : null)">@option</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label for="from" class="form-label mb-1">Başlangıç</label>
        <input id="from" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <label for="to" class="form-label mb-1">Bitiş</label>
        <input id="to" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
</form>

<div id="list-container">
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Belge No</th>
                    <th>Talep Edilen Tarih</th>
                    <th>Saat</th>
                    <th>Lokasyon</th>
                    <th>Hizmet</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr>
                        <td>@row.DocumentNo</td>
                        <td>@TrFormat.Date(row.RequestedDate)</td>
                        <td>@(row.RequestedStartTime is null ? "—" : TrFormat.Time(row.RequestedStartTime.Value))</td>
                        <td><span class="cell-truncate" title="@row.LocationDisplay">@(row.LocationDisplay ?? "—")</span></td>
                        <td><span class="cell-truncate cell-truncate-sm" title="@row.ServiceDisplay">@(row.ServiceDisplay ?? "—")</span></td>
                        @* SADELEŞTİRİLMİŞ etiket: "Ekipman Onayı Bekliyor" ile
                           "Firma Onayı Bekliyor" talep açan için aynı şeydir. *@
                        <td><span class="badge @RequestStatusDisplay.GetBadgeClass(row.Status)">@RequestStatusDisplay.GetSummaryLabel(row.Status)</span></td>
                        <td class="row-actions"><a asp-action="Details" asp-route-id="@row.RequestId">Detay</a></td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="7" class="empty-state">Talep bulunamadı.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Sayfalama">
            <ul class="pagination">
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    var url = Url.Action("Index", new { page = p, status = Model.Status, from = Model.From, to = Model.To });
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@url"
                           hx-get="@url" hx-target="#list-container" hx-select="#list-container"
                           hx-swap="outerHTML" hx-push-url="true">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
