@using MipRental.Domain.Enums
@model MipRental.Web.Models.ProgressPayments.ProgressPaymentDetailsViewModel
@{
    var header = Model.Header;
    ViewData["Title"] = $"Hakediş — {TrFormat.PeriodName(header.Year, header.Month)}";
}

<a asp-action="Index" class="page-back">&larr; Hakediş Onayları</a>
<div class="page-header">
    <div class="page-title">
        <h1>
            Hakediş — @TrFormat.PeriodName(header.Year, header.Month)
            <span class="badge @StatusBadge.Class(header.Status)">@ProgressPaymentStatusLabels.Get(header.Status)</span>
        </h1>
        <div class="page-subtitle">
            @header.FirmTitle — @header.RecordCount kayıt, @TrFormat.MoneyWithCurrency(header.TotalAmount, header.Currency)
        </div>
    </div>
</div>

@if (Model.PendingRecordCountAtCreation > 0)
{
    <div class="alert alert-warning">
        Bu hakediş oluşturulurken dönemde onay bekleyen
        <strong>@Model.PendingRecordCountAtCreation</strong> kayıt vardı, hakedişe dahil edilmedi.
    </div>
}

@if (Model.PendingRecordCountNow != Model.PendingRecordCountAtCreation)
{
    <div class="alert alert-secondary">
        Şu an dönemde onay bekleyen kayıt sayısı: <strong>@Model.PendingRecordCountNow</strong>.
        Hakediş dondurulmuştur; sonradan onaylanan kayıtlar bu hakedişe girmez.
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Bütçe notu</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.BudgetNote) ? "—" : Model.BudgetNote)</dd>

            <dt class="col-sm-3">Bütçe onayı</dt>
            <dd class="col-sm-9">
                @if (header.BudgetApprovedAt is DateTime budgetAt)
                {
                    <text>@Model.BudgetApprovedByName — @TrFormat.DateTimeLocal(budgetAt)</text>
                }
                else
                {
                    <text>—</text>
                }
            </dd>

            <dt class="col-sm-3">Yönetici kararı</dt>
            <dd class="col-sm-9">
                @if (header.ManagerApprovedAt is DateTime managerAt)
                {
                    <text>@Model.ManagerApprovedByName — @TrFormat.DateTimeLocal(managerAt)</text>
                }
                else
                {
                    <text>—</text>
                }
            </dd>

            @if (!string.IsNullOrWhiteSpace(Model.ManagerNote))
            {
                <dt class="col-sm-3">Yönetici notu</dt>
                <dd class="col-sm-9">@Model.ManagerNote</dd>
            }

            @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
            {
                <dt class="col-sm-3">Red gerekçesi</dt>
                <dd class="col-sm-9 text-danger">@Model.RejectionReason</dd>
            }
        </dl>
    </div>
</div>

@* Bütçe'nin imzası: not + "yöneticiye gönder". Bu geçişte mail token'ı üretilir. *@
@if (Model.CanSendToManager)
{
    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="SendToManager" asp-route-id="@header.ProgressPaymentId" method="post">
                <div class="mb-2">
                    <label class="form-label" for="budgetNote">Bütçe notu (opsiyonel)</label>
                    <textarea class="form-control" id="budgetNote" name="budgetNote" rows="2" maxlength="2000"></textarea>
                </div>
                <button type="submit" class="btn btn-success">Onayla ve Yöneticiye Gönder</button>
            </form>
        </div>
    </div>
}

@* B5 — yedek yol: mail kaybolursa aynı karar buradan da verilebilir. *@
@if (Model.CanDecide)
{
    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Approve" asp-route-id="@header.ProgressPaymentId" method="post" class="mb-3">
                <div class="mb-2">
                    <label class="form-label" for="note">Not (opsiyonel)</label>
                    <input class="form-control" id="note" name="note" maxlength="2000" />
                </div>
                <button type="submit" class="btn btn-success">Onayla</button>
            </form>
            <form asp-action="Reject" asp-route-id="@header.ProgressPaymentId" method="post">
                <div class="mb-2">
                    <label class="form-label" for="reason">Red gerekçesi (zorunlu)</label>
                    <input class="form-control" id="reason" name="reason" maxlength="1000" required />
                </div>
                <button type="submit" class="btn btn-outline-danger">Reddet</button>
            </form>
        </div>
    </div>
}

<h2 class="h5">Hakedişe dahil kayıtlar</h2>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Belge No</th>
                <th>İş Tarihi</th>
                <th>Durum</th>
                <th class="num">Tutar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var record in Model.Records)
            {
                <tr>
                    <td><a asp-controller="WorkRecords" asp-action="Details" asp-route-id="@record.WorkRecordId">@record.DocumentNo</a></td>
                    <td>@TrFormat.Date(record.WorkDate)</td>
                    <td><span class="badge @WorkRecordStatusDisplay.GetBadgeClass(record.Status)">@WorkRecordStatusDisplay.GetLabel(record.Status)</span></td>
                    <td class="num">@(record.TotalAmount is null ? "—" : TrFormat.MoneyWithCurrency(record.TotalAmount.Value, record.Currency))</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* B8 — geri çekme: mail kutusundaki bağlantılar da aynı anda iptal olur. *@
@if (Model.CanWithdraw)
{
    <form asp-action="Withdraw" asp-route-id="@header.ProgressPaymentId" method="post" class="mt-3"
          onsubmit="return confirm('Hakediş geri çekilsin mi? Gönderilmiş onay bağlantıları iptal edilecek.');">
        <button type="submit" class="btn btn-outline-secondary">Geri Çek</button>
    </form>
}
