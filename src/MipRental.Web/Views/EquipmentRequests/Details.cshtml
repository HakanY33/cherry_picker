@using MipRental.Domain.Enums
@model MipRental.Web.Models.Requests.EquipmentRequestDetailsViewModel
@{
    ViewData["Title"] = "Talep Detayı";
    var isPending = Model.Status == RequestStatus.PENDING_EQUIPMENT;
}

<a asp-action="Index" class="page-back">&larr; Onay Bekleyen Talepler</a>
<div class="page-header">
    <div class="page-title">
        <h1>
            @Model.DocumentNo
            @* Süreci YÜRÜTEN kişi GERÇEK durumu görür. *@
            <span class="badge @RequestStatusDisplay.GetBadgeClass(Model.Status)">@RequestStatusDisplay.GetLabel(Model.Status)</span>
        </h1>
        <div class="page-subtitle">@Model.RequesterName — @(Model.DepartmentName ?? "departman yok")</div>
    </div>
</div>

@if (!Model.CanDecide)
{
    <div class="alert alert-info">Bu ekranda salt okuma yetkiniz var; karar veremezsiniz.</div>
}
else if (!isPending)
{
    <div class="alert alert-secondary">Bu talep artık Ekipman Müdürlüğü onayında değil; karar verilemez.</div>
}

@* --- Düzenlenemeyen alanlar: talep edenin ihtiyacını tanımlar --- *@
<div class="row g-2 mb-3">
    <div class="col-md-3"><strong>Talep Eden:</strong> @Model.RequesterName</div>
    <div class="col-md-3"><strong>Görev:</strong> @(Model.RequesterPosition ?? "—")</div>
    <div class="col-md-3"><strong>Departman:</strong> @(Model.DepartmentName ?? "—")</div>
    <div class="col-md-3"><strong>Düzenleme Tarihi:</strong> @TrFormat.Date(Model.IssueDate)</div>
    <div class="col-md-6"><strong>Lokasyon:</strong> @(Model.LocationDisplay ?? "—")</div>
    <div class="col-md-6"><strong>İstenen Hizmet:</strong> @(Model.ServiceName ?? "—") @(Model.VariantName is null ? "" : $"— {Model.VariantName}")</div>
</div>

<div class="mb-4">
    <strong>İş Tanımı</strong>
    <p class="mb-0">@(string.IsNullOrWhiteSpace(Model.WorkDescription) ? "—" : Model.WorkDescription)</p>
</div>

@if (Model.CanDecide && isPending)
{
    <div class="form-page">
        <h2>Karar</h2>
        @* Formda SADECE düzenlenebilir alanlar var: tarih, saat, varyant, firma.
           Lokasyon ve iş tanımı burada input olarak bulunmaz — POST'a elle
           eklenseler de EquipmentApprovalModel'de karşılıkları yok. *@
        <form asp-action="Approve" asp-route-id="@Model.RequestId" method="post" class="card card-body bg-light mb-3">
            <div class="row g-3">
                <div class="col-md-4">
                    <label for="RequestedDate" class="form-label">Talep Edilen Tarih</label>
                    <input id="RequestedDate" name="RequestedDate" type="date" class="form-control"
                           value="@Model.RequestedDate.ToString("yyyy-MM-dd")"
                           hx-get="@Url.Action("FirmOptions")"
                           hx-vals='{"serviceId": "@Model.ServiceId"}'
                           hx-target="#firm-wrap"
                           hx-swap="outerHTML"
                           hx-trigger="change" />
                </div>
                <div class="col-md-4">
                    <label for="RequestedStartTime" class="form-label">Başlangıç Saati</label>
                    <input id="RequestedStartTime" name="RequestedStartTime" type="time" class="form-control"
                           value="@Model.RequestedStartTime?.ToString("HH\\:mm")" />
                </div>
                <div class="col-md-4">
                    <label for="VariantId" class="form-label">Hizmet Varyantı</label>
                    @* İstenen kapasite yoksa başka kapasite atanabilir. *@
                    <select id="VariantId" name="VariantId" class="form-select">
                        <option value="">— Yok —</option>
                        @foreach (var item in Model.VariantOptions)
                        {
                            <option value="@item.Value" selected="@(item.Selected ? "selected" : null)">@item.Text</option>
                        }
                    </select>
                </div>
                <partial name="_FirmOptions" model="Model.FirmOptions" />
            </div>
            <div class="form-actions mt-3">
                <button type="submit" class="btn btn-success">Onayla ve Firmaya Gönder</button>
            </div>
        </form>

        <form asp-action="Reject" asp-route-id="@Model.RequestId" method="post" class="card card-body">
            <label for="reason" class="form-label">Red gerekçesi <span class="text-danger">*</span></label>
            <div class="d-flex gap-2 align-items-start">
                <input id="reason" name="reason" class="form-control" maxlength="500" required
                       placeholder="Red nedenini yazın (zorunlu)" />
                <button type="submit" class="btn btn-outline-danger">Reddet</button>
            </div>
        </form>
    </div>
}
