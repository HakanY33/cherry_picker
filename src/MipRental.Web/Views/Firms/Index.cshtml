@model ListViewModel<MipRental.Domain.Entities.Firm>
@{
    ViewData["Title"] = "Firmalar";
}

<div class="page-header">
    <div class="page-title">
        <h1>Firmalar</h1>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary">Yeni Firma</a>
    </div>
</div>

<partial name="_SearchBox" model="Model.Page" />

<div id="list-container">
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Kod</th>
                    <th>Unvan</th>
                    <th>Vergi No</th>
                    <th>Telefon</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var firm in Model.Items)
                {
                    <tr>
                        <td>@firm.Code</td>
                        <td>@firm.Title</td>
                        <td>@firm.TaxNumber</td>
                        <td>@firm.Phone</td>
                        <td><partial name="_StatusBadge" model="firm.IsActive" /></td>
                        <td><a asp-action="Edit" asp-route-id="@firm.FirmId">Düzenle</a></td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">Kayıt bulunamadı.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Page" />
</div>
