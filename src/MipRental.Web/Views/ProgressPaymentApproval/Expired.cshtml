@model string
@{
    ViewData["Title"] = "Süresi Dolmuş Bağlantı";
    Layout = "_VerificationLayout";
}

<h1 class="h3">Bağlantının süresi dolmuş</h1>
<p>@Model dönemi hakedişi için gönderilen onay bağlantısı artık geçerli değil.</p>
<p class="text-muted">
    Onay bağlantıları 7 gün geçerlidir. <strong>Bütçe'den yeni bir bağlantı talep edin.</strong>
</p>
